# Generic OpenAI-compatible model configuration.
# Fill these values after choosing a provider. Common options:
# - qwen: get an API key from Alibaba Cloud Bailian / DashScope, then use its OpenAI-compatible base URL.
# - deepseek: get an API key from DeepSeek Platform, then use its OpenAI-compatible base URL for chat.
# - zhipu: get an API key from BigModel, then use its OpenAI-compatible base URL.
# - openai: get an API key from OpenAI Platform, then use its OpenAI base URL.
MODEL_PROVIDER=qwen
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=your_openai_compatible_chat_base_url_here
LLM_MODEL=your_chat_model_name_here

# Embeddings can use a different provider/model from the chat LLM.
# DeepSeek does not provide a general embedding API, so keep this as qwen/zhipu/openai if MODEL_PROVIDER=deepseek.
EMBEDDING_PROVIDER=qwen
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_BASE_URL=your_openai_compatible_embedding_base_url_here
EMBEDDING_MODEL=your_embedding_model_name_here

# 嵌入请求的超时（秒）。向量化是「单次、无生成」的短请求，正常在秒级完成。
# ⚠ 不设置的话会落到 openai 客户端默认的 600 秒——对这种请求等于没有上限，
#   实测曾导致评估跑批挂死十余分钟、且冻住整个事件循环（连 IM 长连接的收包与心跳
#   一起停摆）。若你的网关较慢可上调，但不建议回到分钟级。
EMBEDDING_TIMEOUT_SECONDS=20

OPENWEATHER_API_KEY=your_openweather_api_key_here

# Optional Azure OpenAI mode:
# If you set MODEL_PROVIDER=azure or EMBEDDING_PROVIDER=azure, also add the required AZURE_OPENAI_* values.
