# Generic OpenAI-compatible model configuration.
# Fill these values after choosing a provider. Common options:
# - qwen: get an API key from Alibaba Cloud Bailian / DashScope, then use its OpenAI-compatible base URL.
# - deepseek: get an API key from DeepSeek Platform, then use its OpenAI-compatible base URL for chat.
# - zhipu: get an API key from BigModel, then use its OpenAI-compatible base URL.
# - openai: get an API key from OpenAI Platform, then use its OpenAI base URL.
MODEL_PROVIDER=qwen
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=your_openai_compatible_chat_base_url_here
LLM_MODEL=your_chat_model_name_here

# Embeddings can use a different provider/model from the chat LLM.
# DeepSeek does not provide a general embedding API, so keep this as qwen/zhipu/openai if MODEL_PROVIDER=deepseek.
EMBEDDING_PROVIDER=qwen
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_BASE_URL=your_openai_compatible_embedding_base_url_here
EMBEDDING_MODEL=your_embedding_model_name_here

OPENWEATHER_API_KEY=your_openweather_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# 任务执行层（change: feishu-channel-integration）
# ─────────────────────────────────────────────────────────────────────────────
# Web 是否经 executor 的同步内联模式执行。默认 true；设为 false 走改造前的直调
# 路径（应急回退用）。
EXECUTOR_ENABLED=true
# 跨会话并行上限。
EXECUTOR_MAX_CONCURRENCY=10
# 单会话等待队列深度上限；超出即以「忙碌」终态拒绝，不入队。
# 同话题是串行的，用户连发 N 条会排出 N 个任务并投递 N 条回复——这个上限防刷屏。
EXECUTOR_MAX_QUEUE_PER_SESSION=5
# 任务墙钟总超时（秒）。超时会中断任务并投递超时提示。
EXECUTOR_WALL_CLOCK_TIMEOUT=600

# ─────────────────────────────────────────────────────────────────────────────
# 飞书 Channel（change: feishu-channel-integration）
# 申请与配置的完整操作指引见 docs/feishu-app-setup.md
# ─────────────────────────────────────────────────────────────────────────────
# 是否启用飞书长连接接入。默认 false——没填凭据时不要打开。
# ⚠ 启用后服务必须单 worker 运行（uvicorn --workers 1，默认即是）：多 worker 会起
#   多份长连接、同一条消息被消费多次，而事件去重表是进程内的、拦不住跨进程重复，
#   重复消费意味着重复下单（create_appointment 目前没有幂等键）。
FEISHU_ENABLED=false
# 开发者后台「凭证与基础信息」页取得。App Secret 等同密码，只放在 .env 里。
FEISHU_APP_ID=cli_your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here
# 国内飞书 https://open.feishu.cn；国际版 Lark https://open.larksuite.com
# 两者 API 同构，同一份代码可跑两个实例。
FEISHU_DOMAIN=https://open.feishu.cn
# 会话作用域：thread=一次 @ 机器人开一条会话（默认，避免整群成员共用一条历史）；
#             chat=整个群共用一条会话。
FEISHU_SESSION_SCOPE=thread
#
# 开放平台需开通的权限（按中文描述勾选，机读名仅供对照报错码）：
#   必需  接收群聊中@机器人消息事件   im:message.group_at_msg:readonly
#   必需  获取与发送单聊、群组消息     im:message
#   必需  以应用的身份发消息          im:message:send_as_bot
#   建议  获取用户发给机器人的单聊消息  im:message.p2p_msg:readonly
#   建议  获取群组信息               im:chat:readonly
#   建议  获取用户基本信息            contact:user.base:readonly
# 另需：①「应用能力」启用「机器人」 ②「事件与回调」订阅方式选**长连接**并添加
#       im.message.receive_v1 ③ 创建版本并通过管理员审核（权限改动都要重新发版才生效）

# Optional Azure OpenAI mode:
# If you set MODEL_PROVIDER=azure or EMBEDDING_PROVIDER=azure, also add the required AZURE_OPENAI_* values.
